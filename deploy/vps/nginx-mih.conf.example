# =============================================================================
# Reverse proxy HOST untuk MIH — VPS multi-aplikasi (nginx di host, bukan Docker).
# TLS & certbot ditangani di sini; MIH sendiri cuma bind 127.0.0.1:8080 (HTTP).
#
# Cara pakai (detail: docs/DEPLOY-VPS.md):
#   1. Ganti semua <domain> dengan domain asli.
#   2. Sertifikat via certbot DNS-01 Cloudflare:
#        certbot certonly --dns-cloudflare --dns-cloudflare-credentials /etc/letsencrypt/cloudflare.ini \
#          -d mih.<domain>.go.id
#   3. cp file ini ke /etc/nginx/sites-available/mih.go.id
#      ln -s /etc/nginx/sites-available/mih.go.id /etc/nginx/sites-enabled/
#      nginx -t && systemctl reload nginx
# =============================================================================

# --- HTTP -> HTTPS redirect ---------------------------------------------------
server {
  listen 80;
  listen [::]:80;
  server_name mih.<domain>.go.id;

  location / {
    return 301 https://$host$request_uri;
  }
}

# --- HTTPS ----------------------------------------------------------------------
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name mih.<domain>.go.id;

  # Sertifikat dari certbot (DNS-01 Cloudflare, lihat docs/DEPLOY-VPS.md)
  ssl_certificate     /etc/letsencrypt/live/mih.<domain>.go.id/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/mih.<domain>.go.id/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  # Upload dokumen bisa besar (12m, sama dengan Arthakarya)
  client_max_body_size 12m;

  # Security headers
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # CSP dasar untuk SPA; frontend MIH tidak butuh sumber eksternal
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" always;

  # Semua request diteruskan ke frontend MIH (nginx internal, port 8080 host).
  # MIH nginx menangani /api/ -> backend:3000 dan SPA fallback sendiri.
  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }
}
